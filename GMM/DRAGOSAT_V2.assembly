GEOMETRY FIX_STR;
FIX_STR = INS + RADIATOR + IR_CAM + 
    BODY + MLI;

DRAGOSAT_V2 = ASSEMBLE (
    ref_comp = FIX_STR,
    moving_comp = SPS,
    xt = 0.0,
    yt = 0.0,
    zt = 0.0,
    xr = 0.0,
    yr = 0.0,
    zr = 0.0,
    order = "xtytztxryrzr",
    orientation = "TRUE_SUN",
    point_vect = [0.0, 0.0, 1.0],
    rot_point = [0.0, 0.0, 0.0],
    rot_axis = [0.0, 1.0, 0.0],
    gen_vect = [0.0, 0.0, 1.0],
    rot_min_ang = 0.0,
    rot_max_ang = 360.0,
    bisecting = FALSE,
    focus_point = [0.0, 0.0, 0.0],
    initial_angle = 0.0,
    rotation_rate = 0.0,
    stop_point_eclipse = FALSE);

